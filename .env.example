# --- Intelligenza artificiale (sul SERVER: non entra mai nel bundle del browser) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_IMAGE_MODEL=gpt-image-1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Accesso e dati ---
# Codice che serve per creare un account. IMPOSTALO SEMPRE online: senza, il primo
# visitatore potrebbe registrarsi per primo e diventare amministratore.
INVITE_CODE=
# SIGNUP_OPEN=true            # registrazione libera a chiunque (sconsigliato con la tua chiave AI)

# Cartella del database SQLite. Su Railway: monta un Volume su /data e imposta DATA_DIR=/data
# DATA_DIR=./data

# --- Limiti d'uso per utente ---
# AI_DAILY_LIMIT=150          # richieste all'assistente al giorno
# IMAGE_DAILY_LIMIT=40        # immagini generate al giorno
# VIDEO_DAILY_LIMIT=200       # ricerche video al giorno
# STORAGE_LIMIT_MB=400        # spazio foto per utente

# --- Facoltativi ---
# YOUTUBE_API_KEY=            # ricerca video stabile (YouTube Data API v3)
# VITE_CONTACT_EMAIL=         # contatto mostrato in privacy e termini (da impostare prima di build)
